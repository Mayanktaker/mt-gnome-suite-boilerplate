{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "extras/fastfetch/mt-verdant.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 🌿 "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#3DD68C",
        "at": "#8FB8A6",
        "host": "#E9F1EC"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "color": "#2C3E44"
    },
    {
      "type": "os",
      "key": "OS",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "host",
      "key": "Host",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "de",
      "key": "Desktop",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "theme",
      "key": "Theme",
      "keyColor": "#3DD68C"
    },
    {
      "type": "icons",
      "key": "Icons",
      "keyColor": "#3DD68C"
    },
    {
      "type": "cursor",
      "key": "Cursor",
      "keyColor": "#3DD68C"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "#8FB8A6"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
